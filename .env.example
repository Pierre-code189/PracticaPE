# Copiar a .env y completar (nunca subir el .env real)
# Clave firmada de los tokens: si va vacía se genera una en data/.secret
SECRET_KEY=
# none | smtp | gmail
MAIL_BACKEND=none
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PracticaPE <no-reply@practicape.pe>
SMTP_TLS=1
# Solo para desarrollo: devuelve el código OTP en la respuesta. 0 en producción.
OTP_DEV_CODE=0
GMAIL_TOKEN_PATH=/app/data/gmail_token.json
GMAIL_FROM=
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 1 = crea datos de ejemplo al arrancar el contenedor
SEED_ON_START=0
